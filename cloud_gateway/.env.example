# Copy to .env on the server. Never commit the real .env file.
# SHA-256 hashes only: user_id:64_character_sha256_hex[,user_id:hash...]
SHZ_GATEWAY_TOKEN_HASHES=
# Provider credentials are stored ONLY on the gateway host.
SHZ_UPSTREAM_API_KEY=
# Optional OpenAI-compatible upstream URL; leave empty for OpenAI.
SHZ_UPSTREAM_BASE_URL=
SHZ_UPSTREAM_TIMEOUT=120
# Add exact trusted web origins only if browser clients are used.
SHZ_CORS_ORIGINS=
